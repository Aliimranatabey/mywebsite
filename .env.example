# Bu dosya şablondur, git'e girer. Gerçek şifreler .env dosyasına yazılır.
# Kurulum: cp .env.example .env  →  sonra .env içini kendi bilgilerinle doldur.

# İletişim formunun mail göndereceği Gmail hesabı
MAIL_USERNAME=senin_adresin@gmail.com

# Gmail normal şifresi DEĞİL — "Uygulama Şifresi" (16 haneli).
# Nasıl alınır: myaccount.google.com → Güvenlik → 2 Adımlı Doğrulama (açık olmalı)
#               → Uygulama şifreleri → yeni oluştur
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# Formdan gelen mesajların düşeceği adres
CONTACT_RECIPIENT=aliimranatabey@gmail.com

# Veritabanı şifresi. Boş bırakılırsa lokal geliştirme şifresi (devpass) kullanılır;
# canlıda MUTLAKA doldur: openssl rand -base64 24
POSTGRES_PASSWORD=

# pgAdmin girişi (canlıda pgAdmin'i hiç çalıştırmamak en iyisi)
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Yeni üye kaydı. Kapalı (false) tutulur; kendi hesabını açarken geçici olarak true yap.
REGISTRATION_ENABLED=false

# ---------- Sadece SUNUCUDA doldur (lokalde boş bırak) ----------

# prod: HTTPS için Caddy açılır. Lokalde boş bırak (ya da pgAdmin için "dev").
COMPOSE_PROFILES=

# Alan adın, başında https:// ve www olmadan. Örn: aliimranatabey.com
DOMAIN=

# HTTPS çalışınca true: oturum çerezi sadece şifreli bağlantıda gider
COOKIE_SECURE=false
